APP_NAME="SEMIZZY VTU"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=semizzy_vtu
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# VTU stays on the generic disabled adapter unless explicitly selected.
VTU_PROVIDER_DRIVER=configured
VTU_PROVIDER_NAME=configured_vtu
VTU_PROVIDER_ENDPOINT=
VTU_PROVIDER_TOKEN=

# Multi-provider routing is opt-in; post-submit failover is hard-disabled in code for this release.
VTU_MULTI_PROVIDER_ENABLED=false
VTU_PROVIDER_PRIORITY=sogo,gsubz,dataway
VTU_SOGO_BASE_URL=https://sandbox.sogo.africa/v1
VTU_SOGO_API_KEY=
VTU_SOGO_WEBHOOK_SECRET=
VTU_GSUBZ_BASE_URL=https://api.gsubz.com
VTU_GSUBZ_API_KEY=
VTU_GSUBZ_WEBHOOK_SECRET=
VTU_DATAWAY_BASE_URL=https://dataway.ng/api/v1/merchant
VTU_DATAWAY_API_KEY=
VTU_DATAWAY_WEBHOOK_SECRET=

# VTpass sandbox adapter. Never commit real credentials; keep live use disabled until validated.
VTU_VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTU_VTPASS_API_KEY=
VTU_VTPASS_SECRET_KEY=

PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=${APP_URL}/wallet/funding/return

SEMIZZY_WEBHOOK_SECRET=
SEMIZZY_WEBHOOK_TOLERANCE_SECONDS=300
SEMIZZY_PAYMENT_INTENT_TTL_MINUTES=30
PAYMENTS_RECONCILIATION_GRACE_MINUTES=5
PAYMENTS_REFUND_STALE_MINUTES=15
PAYMENTS_ALERT_WEBHOOK_URL=

VITE_APP_NAME="${APP_NAME}"
